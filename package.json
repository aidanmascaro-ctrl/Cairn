{
  "name": "cairn",
  "version": "0.0.1",
  "description": "DaVinci Resolve Workflow Integration Plugin — identifies, doesn't assemble.",
  "type": "commonjs",
  "main": "src/orchestrator/main.js",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build:ui": "vite build",
    "build": "npm run build:ui",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "test": "vitest run",
    "install-plugin": "bash packaging/install-dev-plugin.sh",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^3.1.1",
    "@tsconfig/svelte": "^5.0.4",
    "@types/node": "^20.12.12",
    "electron": "^30.0.6",
    "eslint": "^10.2.1",
    "eslint-plugin-svelte": "^3.17.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^3.5.1",
    "svelte": "^4.2.17",
    "svelte-check": "^3.7.1",
    "tslib": "^2.6.2",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.59.0",
    "vite": "^5.2.11",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "keytar": "^7.9.0",
    "zod": "^4.3.6"
  },
  "lint-staged": {
    "*.{ts,tsx,svelte,js,mjs,mts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.py": [
      "ruff check --fix",
      "ruff format"
    ]
  }
}
